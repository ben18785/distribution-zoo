chain1 <- mcmc(n_iterations, X, 20)
chain2 <- mcmc(n_iterations, X, 5)
tibble(chain1=chain1, chain2=chain2) %>%
mutate(iteration=seq_along(chain1)) %>%
pivot_longer(-iteration) %>%
ggplot(aes(x=iteration, y=value, colour=name)) +
geom_line() +
scale_color_brewer(palette = "Dark2")
