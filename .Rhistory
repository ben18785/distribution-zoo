posterior_numerator <- function(R, alpha, beta, I1, I2) {
prior(R, alpha, beta) * likelihood(I1, I2, R)
}
posterior <- function(R, alpha, beta, I1, I2) {
dgamma(R, alpha + I2, beta + I1)
}
I1 <- 5
I2 <- 10
alpha <- 4
beta <- 2
posteriors_un <- vector(length = length(Rs))
posteriors <- vector(length = length(Rs))
for(i in seq_along(posteriors_un)) {
posteriors_un[i] <- posterior_numerator(Rs[i], alpha, beta, I1, I2)
posteriors[i] <- posterior(Rs[i], alpha, beta, I1, I2)
}
plot(Rs, posteriors)
lines(Rs, posteriors_un)
