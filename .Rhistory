propose_new_N <- function(N) {
is_increase <- rbinom(n=1, size=1, prob = 0.5)
if(is_increase)
N_proposed <- N + 1
else
N_proposed <- N - 1
if(N_proposed == 0) {
1
} else if(N_proposed == 21) {
20
} else {
N_proposed
}
}
