mcmc <- function(n_iterations, X, N_0) {
Ns <- vector(n_iterations + 1)
Ns[1] <- N_0
for(i in 1:n_iterations) {
Ns[i + 1] <- step_accept_reject(Ns[i], X)
}
Ns
}
Ns <- mcmc(20, X, 18)
